# Cooperative MCP profile for one trusted project. Copy this table into the target
# project's .codex/config.toml and replace every placeholder. This file is not active.
#
# Use the Python executable from the environment where you installed the Library:
# Windows: C:/absolute/path/to/library-of-context/.venv/Scripts/python.exe
# macOS/Linux: /absolute/path/to/library-of-context/.venv/bin/python
[mcp_servers.library_of_context]
command = "C:/absolute/path/to/library-of-context/.venv/Scripts/python.exe"
args = [
  "-m",
  "library_of_context.mcp_server",
  "--no-redis",
  "--db",
  "C:/absolute/path/to/library-of-context/data/your-project.sqlite",
  "--namespace",
  "replace-with-your-project-slug",
]
cwd = "C:/absolute/path/to/library-of-context"
startup_timeout_sec = 10
tool_timeout_sec = 120
enabled = true
required = false
default_tools_approval_mode = "writes"
enabled_tools = [
  "library_shelve",
  "library_shelve_document",
  "library_consult",
  "library_desk_refresh",
  "library_desk_get",
  "library_desk_watch",
  "library_desk_stop",
  "library_stats",
]
